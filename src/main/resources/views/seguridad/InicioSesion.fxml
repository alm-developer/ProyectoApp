<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@../../estilos/estilosprueba.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.seguridad.InicioSesionController">
   <center>
      <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="VBOX-GradienteDerecho" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER" prefHeight="450.0" prefWidth="470.0" HBox.hgrow="ALWAYS">
               <children>
                  <ImageView focusTraversable="true" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../images/logo.png" />
                     </image>
                     <viewport>
                        <Rectangle2D />
                     </viewport></ImageView>
               </children>
            </VBox>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" />
               </HBox.margin>
               <children>
                  <BorderPane VBox.vgrow="ALWAYS">
                     <center>
                        <VBox alignment="CENTER" spacing="5.0" BorderPane.alignment="CENTER">
                           <children>
                              <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="23.0" prefWidth="320.0" styleClass="label-Titulos-1" stylesheets="@../../estilos/estilos.css" text="INICIO SESION" textAlignment="CENTER">
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </Label>
                              <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="18.0" prefWidth="215.0" styleClass="Label-Pedir1" text="Usuario">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </Label>
                              <TextField fx:id="idEntradaUsuario" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="TextFieldEntrada1">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </TextField>
                              <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="18.0" prefWidth="342.0" styleClass="Label-Pedir1" text="Contraseña">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="3.0" />
                                 </padding>
                              </Label>
                              <TextField fx:id="idEntradaContraseña" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="279.0" styleClass="TextFieldEntrada1">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </TextField>
                              <Button fx:id="idBtnConfirmar" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#iniciarSesion" prefHeight="31.0" prefWidth="341.0" styleClass="ButtonConfirmar1" text="confirmar" />
                              <HBox alignment="CENTER" prefHeight="15.0" prefWidth="342.1" spacing="15.0">
                                 <children>
                                    <Hyperlink fx:id="idIrRegistro" contentDisplay="RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#irRegistro" prefHeight="24.0" prefWidth="213.0" styleClass="Hypervinculos1" text="¿No tienes cuenta?" />
                                    <Region prefHeight="14.0" prefWidth="123.0" HBox.hgrow="ALWAYS" />
                                    <Hyperlink alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefHeight="24.0" prefWidth="265.0" styleClass="Hypervinculos1" text="¿Has olvidado tu contraseña?" />
                                 </children>
                              </HBox>
                              <Label fx:id="idTextoErrores" alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="18.0" prefWidth="334.0" styleClass="TextoErrores1" text="salen errores">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </Label>
                           </children>
                           <padding>
                              <Insets left="30.0" right="30.0" />
                           </padding>
                        </VBox>
                     </center>
                  </BorderPane>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
